# dstui makeself startup script (body; prepended at build time with
# #!/bin/sh + DSTUI_VERSION= + PYVER=).
#
# makeself (built with --nox11 --nocomp) extracts this dir to a temp location and
# runs this script from there, as `sh ./startup.sh` (never exec'd directly: the
# temp dir may be mounted noexec). The dir contains:
#   ./zstd            a bundled STATIC zstd (so the target needs no zstd)
#   ./bundle.tar.zst  the zstd-compressed CPython + dstui + deps tree
#
# We decompress with the bundled zstd, then lay the tree into an install prefix
# and expose `dstui`. Install prefix resolution (highest first):
#   1. `--prefix DIR`  (pass as: sh dstui-install.sh -- --prefix DIR)
#   2. $DSTUI_PREFIX
#   3. $HOME/.local
# Plain `--target DIR` is makeself's own option: it extracts the raw payload into
# DIR, keeps it there and still runs this script, which installs into the default
# prefix. Only `-- --target` reaches this script, and it is refused.
#
# DeepSeek Harness (`dsh`, npm @deepseek-ai/dsh) is NOT in the bundle: it is a
# separate install, and dstui finds it on PATH (or via --dsh-bin).
set -eu

# makeself runs us under umask 077. The installed tree is software for every user
# of the prefix (e.g. /usr/local): readable and runnable by all, writable by the
# installing user only.
umask 022

usage() {
  echo "Usage: sh dstui-install.sh [-- --prefix DIR]   (or set DSTUI_PREFIX)"
}

PREFIX="${DSTUI_PREFIX:-$HOME/.local}"
while [ $# -gt 0 ]; do
  case "$1" in
    --prefix)
      if [ $# -lt 2 ]; then
        echo "error: --prefix needs a directory" >&2; usage >&2; exit 2
      fi
      PREFIX="$2"; shift 2 ;;
    --prefix=*) PREFIX="${1#*=}"; shift ;;
    -h|--help)
      echo "dstui ${DSTUI_VERSION} installer"
      usage
      exit 0 ;;
    *) echo "error: unknown option '$1'" >&2; usage >&2; exit 2 ;;
  esac
done
[ -n "$PREFIX" ] || { echo "error: empty install prefix" >&2; exit 2; }

# makeself runs this script inside its temp dir and deletes that afterwards: a
# relative prefix means the directory the installer was started from, which
# makeself exports as $USER_PWD. A quoted ~ means $HOME.
# shellcheck disable=SC2088  # a literal ~ is exactly what is matched here
case "$PREFIX" in
  /*) ;;
  '~'|'~/'*) PREFIX="$HOME${PREFIX#\~}" ;;
  *) PREFIX="${USER_PWD:-$PWD}/$PREFIX" ;;
esac

here="$(pwd)"                       # makeself extraction dir (zstd + bundle.tar.zst)

# The bundled interpreter every console script resolves to. `-I` (isolated mode)
# makes the bundle hermetic: PYTHONPATH, PYTHONHOME and the other PYTHON*
# variables, the user site and the script's directory never reach sys.path.
# The kernel splits a shebang at whitespace and cannot exec one over 127 bytes,
# so refuse such a prefix — before anything is created, unpacked or replaced.
tab="$(printf '\t')"
nl='
'
set_shebang() {
  BUNDLE_PY="$PREFIX/lib/dstui/bin/python$PYVER"
  shebang="#!$BUNDLE_PY -I"
  case "$BUNDLE_PY" in
    *" "*|*"$tab"*|*"$nl"*)
      echo "error: install path '$PREFIX' contains whitespace, which a '#!' line cannot" >&2
      echo "       carry. Re-run with DSTUI_PREFIX (or -- --prefix DIR) set to a path without it." >&2
      exit 1 ;;
  esac
  # In bytes, as the kernel counts: where sh is bash (Fedora, RHEL, Arch), ${#shebang}
  # counts characters under a UTF-8 locale. $((…)) drops any padding wc may print.
  bytes=$(($(printf '%s' "$shebang" | wc -c)))
  if [ "$bytes" -gt 127 ]; then
    echo "error: install path too long — shebang '$shebang' is $bytes bytes" >&2
    echo "       (kernel limit 127). Re-run with a shorter DSTUI_PREFIX (or -- --prefix DIR)." >&2
    exit 1
  fi
}
set_shebang

mkdir -p -- "$PREFIX"
PREFIX="$(CDPATH= cd -- "$PREFIX" && pwd)"
set_shebang                         # again for the final path (no `.`, `..` or `//`)
LIB="$PREFIX/lib/dstui"
BINDIR="$PREFIX/bin"
DOCDIR="$PREFIX/share/doc/dstui"

echo "Installing dstui ${DSTUI_VERSION} -> $PREFIX"

# The bundled programs must run on this host: checked before anything is replaced.
cannot_run() {
  echo "error: the bundled $1 cannot run on this host. It needs Linux x86-64 with" >&2
  echo "       glibc >= 2.17 (not musl), and a prefix that is not mounted noexec." >&2
  exit 1
}

# Decompress the heavy payload with the BUNDLED static zstd (target needs none).
# Stage on the SAME filesystem as the target for a fast rename, and run zstd from
# there too: makeself's temp dir may be mounted noexec. The prefix must not be:
# that shows here first, as a zstd that cannot run.
stage="$PREFIX/.dstui-install.$$"
rm -rf "$stage"; mkdir -p "$stage"
trap 'rm -rf "$stage"' EXIT INT TERM
cp "$here/zstd" "$stage/.zstd"
chmod 700 "$stage/.zstd"
"$stage/.zstd" --version >/dev/null 2>&1 || cannot_run zstd
# --no-same-owner: as root, tar would otherwise restore the archive's owner.
"$stage/.zstd" -dc "$here/bundle.tar.zst" | tar --no-same-owner -xf - -C "$stage"   # -> stage/python, stage/doc
rm -f "$stage/.zstd"
# Whoever installs owns the tree (root included); everyone may read and run it.
chmod -R u+rwX,go+rX,go-w "$stage"

"$stage/python/bin/python$PYVER" -I -c 'import dstui' >/dev/null 2>&1 || cannot_run Python

mkdir -p "$BINDIR" "$PREFIX/lib" "$PREFIX/share/doc"
rm -rf "$LIB"; mv "$stage/python" "$LIB"
if [ -d "$stage/doc" ]; then rm -rf "$DOCDIR"; mv "$stage/doc" "$DOCDIR"; fi

# Repoint console-script shebangs (pip stamped a build-time path) at the bundled
# interpreter on THIS machine. grep -I skips the interpreter binary.
for f in "$LIB"/bin/*; do
  [ -f "$f" ] || continue
  grep -Iqm1 '^#!.*python' "$f" 2>/dev/null || continue
  tmp="$f.dstui-fix.$$"
  { printf '%s\n' "$shebang"; tail -n +2 "$f"; } > "$tmp"
  chmod 755 "$tmp"; mv "$tmp" "$f"
done

# Only `dstui` goes on PATH. The bundled interpreter deliberately does NOT:
# $BINDIR is normally ~/.local/bin, which sits ahead of /usr/bin for most users,
# so linking it there as python$PYVER would shadow the host's own python$PYVER
# for every command in the shell — with an interpreter that is sourceless,
# carries dstui's site-packages, and has had pip/setuptools stripped. Console
# scripts do not need the link: their shebangs were rewritten above to
# $BUNDLE_PY as an absolute path.
ln -sf "$LIB/bin/dstui" "$BINDIR/dstui"

echo "Installed:"
echo "  $BINDIR/dstui      ->  $LIB/bin/dstui  (Python console script)"
echo "  $LIB/  (CPython $PYVER + dstui + deps, sourceless precompiled)"
echo ""
echo "dstui needs DeepSeek Harness (dsh), which is installed separately:"
echo "  npm install -g @deepseek-ai/dsh     (Node.js >= 22.19)"
if command -v dsh >/dev/null 2>&1; then
  echo "  found: $(command -v dsh)"
else
  echo "  not found on PATH yet (or run dstui --dsh-bin PATH)"
fi
case ":${PATH}:" in
  *":$BINDIR:"*) echo "Run: dstui --help" ;;
  *) echo "Add $BINDIR to PATH:  export PATH=\"$BINDIR:\$PATH\"" ;;
esac
